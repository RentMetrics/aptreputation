# ---- Next.js (.env.local) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional: address printed on card links and outreach (default https://www.aptreputation.com)
# NEXT_PUBLIC_SITE_URL=

# ---- Convex environment (set with `npx convex env set NAME value`) ----
# CLERK_JWT_ISSUER_DOMAIN   https://<your-instance>.clerk.accounts.dev  (Clerk JWT template must be named "convex")
# APP_URL                   http://localhost:3000 in dev, the live site URL in production
# GOOGLE_MAPS_API_KEY       Places API key (server-side only)
# GOOGLE_CLIENT_ID          OAuth client; redirect URI = <APP_URL>/api/google/callback
# GOOGLE_CLIENT_SECRET
# ANTHROPIC_API_KEY         review analysis, reply drafts, insights
# RESEND_API_KEY           new-review alerts and invitations (domain must be verified in Resend)
# RESEND_FROM              optional; default "AptReputation <alerts@aptreputation.com>"
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET     endpoint = https://<deployment>.convex.site/stripe/webhook
# STRIPE_PRICE_ID           optional; without it checkout charges $99/property/month inline
# ADMIN_EMAILS              comma-separated emails that get the Admin area
# OUTREACH_LIVE             "on" to send approved outreach emails to properties (production only)
# OUTREACH_TEST_TO          when not live, send every outreach email to this address instead
# OUTREACH_DAILY_CAP        optional; default 40 emails a day
# OUTREACH_FROM             optional; default "AptReputation <contact@aptreputation.com>"
# RESEND_WEBHOOK_SECRET     bounces and complaints; endpoint = https://<deployment>.convex.site/resend/webhook
